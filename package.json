{
  "name": "bombastic",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "npm run format && npm run check && vite build",
    "build:preview": "vite build --mode preview",
    "build:test": "npm run check && vite build",
    "build:aws": "npm run check && vite build --mode production",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "dev:memory": "NODE_OPTIONS='--max-old-space-size=4096' vite dev",
    "dev:no-processing": "DISABLE_IMAGE_PROCESSING=true vite dev",
    "dev:test": "NODE_ENV=test vite dev --mode test",
    "format": "node --max-old-space-size=4096 ./node_modules/.bin/prettier --write --log-level error .",
    "format:src": "node --max-old-space-size=4096 ./node_modules/.bin/prettier --write --log-level error src/",
    "format:check": "node --max-old-space-size=4096 ./node_modules/.bin/prettier --check --log-level error .",
    "generate-types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "lint": "node --max-old-space-size=4096 ./node_modules/.bin/prettier --check . && node --max-old-space-size=8192 ./node_modules/.bin/eslint .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "supabase:seed": "supabase db dump -f supabase/seed.sql --data-only -x public.notifications -x storage.buckets -x storage.objects -x storage.prefixes",
    "supabase:seed-images": "tsx supabase/scripts/seed-content-images.ts",
    "supabase:upload-images": "tsx supabase/scripts/upload-content-images.ts",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "test:db:reset": "supabase db reset",
    "test:db:setup": "node scripts/setup-test-db.js",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium ",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:desktop": "playwright test --project='chromium' --project='firefox' --project='webkit'",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "test:e2e:reset": "RESET_DB=true playwright test",
    "test:e2e:reset-each": "RESET_DB=true RESET_DB_EACH_TEST=true playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run src/routes/",
    "test:e2e:single": "playwright test --grep",
    "test:e2e:headed:single": "playwright test --headed --grep",
    "test:setup": "supabase start && npm run generate-types",
    "test:sql": "supabase test db",
    "test:teardown": "supabase stop",
    "test:unit": "vitest run src/lib/",
    "test:watch": "vitest --ui",
    "twitch:webhook:setup": "tsx scripts/setup-twitch-webhooks.ts setup",
    "twitch:webhook:list": "tsx scripts/setup-twitch-webhooks.ts list",
    "twitch:webhook:cleanup": "tsx scripts/setup-twitch-webhooks.ts cleanup"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.47.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^8.21.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@trigger.dev/build": "4.6.3",
    "@types/crypto-js": "^4.2.2",
    "@types/pg": "^8.23.1",
    "@types/youtube": "^0.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "formsnap": "^2.0.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "jsdom-global": "^3.0.2",
    "mdsvex": "^0.12.8",
    "mode-watcher": "^1.1.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "runed": "^0.37.1",
    "supabase-cli": "^0.0.21",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-dnd-action": "^0.9.79",
    "svelte-easy-crop": "^5.0.1",
    "svelte-sonner": "^1.2.1",
    "svelte-toolbelt": "^0.10.6",
    "sveltekit-embed": "^0.0.22",
    "sveltekit-flash-message": "^2.4.6",
    "sveltekit-sse": "^0.15.1",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-variants": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.1",
    "vitest-mock-extended": "^5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@googleapis/youtube": "^39.0.0",
    "@neodrag/svelte": "^2.3.3",
    "@neondatabase/postgrest-js": "^0.2.0-beta",
    "@supabase/postgrest-js": "2.79.0",
    "@supabase/supabase-js": "^2.116.0",
    "@trigger.dev/sdk": "4.6.3",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-http": "^8.2.0",
    "@types/marked": "^6.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "aws-jwt-verify": "^5.2.1",
    "bad-words": "^4.1.5",
    "crypto-js": "^4.2.0",
    "debounce": "^3.0.0",
    "embla-carousel-svelte": "^8.6.0",
    "jose": "^6.2.12",
    "marked": "^18.0.13",
    "paneforge": "^1.0.2",
    "posthog-js": "^1.434.3",
    "posthog-node": "^5.52.5",
    "sharp": "^0.35.4",
    "svelte-radix": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  }
}
