{
  "name": "bombify",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate-types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "supabase:seed": "supabase db dump -f supabase/seed.sql --data-only",
    "supabase:seed:auth": "supabase db dump --schema auth -f supabase/seed-auth.sql --data-only",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.31.0",
    "@internationalized/date": "^3.8.2",
    "@lucide/svelte": "^0.525.0",
    "@sveltejs/adapter-auto": "^6.0.1",
    "@sveltejs/adapter-netlify": "^5.0.2",
    "@sveltejs/enhanced-img": "^0.6.1",
    "@sveltejs/kit": "^2.22.5",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/table-core": "^8.21.3",
    "@twurple/api": "^7.3.0",
    "@twurple/auth": "^7.3.0",
    "@twurple/eventsub-http": "^7.3.0",
    "@twurple/pubsub": "^7.3.0",
    "@types/sharp": "^0.32.0",
    "@types/youtube": "^0.1.2",
    "autoprefixer": "^10.4.21",
    "bits-ui": "^2.8.10",
    "clsx": "^2.1.1",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-svelte": "^3.10.1",
    "formsnap": "^2.0.1",
    "globals": "^16.3.0",
    "layerchart": "^2.0.0-next.10",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "runed": "^0.30.0",
    "svelte": "^5.35.6",
    "svelte-check": "^4.2.2",
    "svelte-dnd-action": "^0.9.63",
    "svelte-easy-crop": "^4.0.1",
    "svelte-sonner": "^1.0.5",
    "svelte-toolbelt": "^0.9.3",
    "sveltekit-embed": "^0.0.22",
    "sveltekit-flash-message": "^2.4.6",
    "sveltekit-sse": "^0.14.1",
    "sveltekit-superforms": "^2.27.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-variants": "^1.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.0.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@googleapis/youtube": "^27.0.1",
