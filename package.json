    "@supabase/supabase-js": "^2.50.5",
    "@tanstack/svelte-query": "^5.83.0",
    "@twurple/eventsub-ngrok": "^7.3.0",
    "amazon-cognito-identity-js": "^6.3.15",
    "bad-words": "^4.0.0",
    "debounce": "^2.2.0",
    "embla-carousel-svelte": "^8.6.0",
    "sharp": "^0.34.3",
    "svelte-radix": "^2.0.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5"
  }
}
