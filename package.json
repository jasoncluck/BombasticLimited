{
  "name": "bombify",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate-types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "supabase:seed": "supabase db dump -f supabase/seed.sql --data-only",
    "supabase:seed:auth": "supabase db dump --schema auth -f supabase/seed-auth.sql --data-only",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.8",
    "@eslint/js": "^9.23.0",
    "@internationalized/date": "^3.8.0",
    "@lucide/svelte": "^0.511.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-netlify": "^5.0.0",
    "@sveltejs/enhanced-img": "^0.4.4",
    "@sveltejs/kit": "^2.20.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/table-core": "^8.21.3",
    "@twurple/api": "^7.2.1",
    "@twurple/auth": "^7.2.1",
    "@twurple/eventsub-http": "^7.2.1",
    "@twurple/pubsub": "^7.2.1",
    "@types/youtube": "^0.1.0",
    "autoprefixer": "^10.4.21",
    "bits-ui": "^1.5.2",
    "clsx": "^2.1.1",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-svelte": "^3.5.0",
    "formsnap": "^2.0.1",
    "globals": "^16.0.0",
    "layerchart": "^2.0.0-next.10",
    "mode-watcher": "^1.0.7",
    "paneforge": "^1.0.0-next.5",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "runed": "^0.28.0",
    "svelte": "^5.25.6",
    "svelte-check": "^4.1.5",
    "svelte-dnd-action": "^0.9.61",
    "svelte-easy-crop": "^4.0.1",
    "svelte-sonner": "^1.0.4",
    "svelte-toolbelt": "^0.7.1",
    "sveltekit-embed": "^0.0.20",
    "sveltekit-flash-message": "^2.4.6",
    "sveltekit-sse": "^0.13.16",
    "sveltekit-superforms": "^2.25.0",
    "tailwind-merge": "^3.3.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-variants": "^1.0.0",
    "tsx": "^4.19.3",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^6.2.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@googleapis/youtube": "^26.0.1",
    "@neodrag/svelte": "^2.3.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/svelte-query": "^5.71.5",
    "@twurple/eventsub-ngrok": "^7.2.1",
    "amazon-cognito-identity-js": "^6.3.15",
    "debounce": "^2.2.0",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "svelte-radix": "^2.0.1",
    "tailwindcss": "^4.1.1"
  }
}
