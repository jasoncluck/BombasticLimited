# Copy this file to .env and fill in the values.
# See README.md for how to get each of these from a deployed BombasticAuthStack
# / Neon project / S3 bucket.

# ── Neon (serverless Postgres) ─────────────────────────────────────────────────
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=
PUBLIC_NEON_DATA_API_URL=

# ── AWS Cognito (auth) ──────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
COGNITO_REGION=
COGNITO_HOSTED_UI_DOMAIN=

# Dedicated Cognito user the server signs in as for anonymous/public Neon Data
# API access (Neon requires a valid JWT on every request, even for public reads).
COGNITO_ANON_USER_EMAIL=
COGNITO_ANON_USER_PASSWORD=

# ── Discord (federated login) ───────────────────────────────────────────────────
# The OAuth app itself is configured on the Cognito Identity Provider (see
# cdk/lib/stack/auth-stack.ts), not here. This bot token is used separately to
# fetch the real Discord username/avatar, since Cognito's Discord OIDC
# integration doesn't expose either — see src/lib/server/discord.ts.
DISCORD_BOT_TOKEN=

# ── S3 (content images) ─────────────────────────────────────────────────────────
PUBLIC_CONTENT_IMAGES_URL=

# Email that gets account_type='admin' at profile creation (src/lib/server/profile.ts)
ADMIN_EMAIL=

# Symmetric key encrypting premium podcast feed URLs at rest (pgcrypto). Generate
# with: openssl rand -base64 32
PODCAST_FEED_ENCRYPTION_KEY=

# ── YouTube Data API (catalog sync) ─────────────────────────────────────────────
GOOGLE_API_KEY=

# ── Twitch (live stream status) ─────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ngrok auth token for exposing local webhook endpoints to Twitch EventSub
NGROK_AUTH_TOKEN=
