# SQL Testing Environment Configuration
# Copy this file to .env.local and customize for your environment

# Database connection settings for SQL tests
TEST_DB_HOST=localhost
TEST_DB_PORT=54322
TEST_DB_NAME=postgres
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# Test behavior settings
SQL_TESTS_SKIP_DB_UNAVAILABLE=true
SQL_TESTS_VERBOSE_LOGGING=false
SQL_TESTS_RESET_DB_BETWEEN_TESTS=true

# Performance test settings
SQL_TESTS_BATCH_SIZE=100
SQL_TESTS_MAX_INSERT_TIME_MS=5000
SQL_TESTS_MAX_QUERY_TIME_MS=1000