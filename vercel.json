{
  "buildCommand": "npm run build:vercel",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "sveltekit",
  "regions": ["sfo1", "iad1", "dub1"],
  "git": {
    "deploymentEnabled": {
      "copilot*": false
    }
  },
  "headers": [
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
